class Solution {
public:
    int binaryGap(int n) {    // given any number
        vector<int> bin;
    

        int i = 0;
        int binary[32];

        while (n > 0) {

          
            bin.push_back(n%2);
            n /= 2 ;
        }

       
        int ans = 0;
        int prev = -1 ;

       

        for (int i = 0; i < bin.size(); i++) {
            if (bin[i] == 1) {
                if (prev == -1) {
                prev = i;
                }else {
                    ans = max(ans, i - prev);
                }
                prev = i;
            }
        
        }


            return ans;
        }
    };
