class Solution {
public:
    int repeatedNTimes(vector<int>& nums) {
        int count = 1, ans = 0 ,maxcount = 0, val = 0;
        sort(nums.begin(), nums.end());

        for (int i = 0; i < nums.size()-1; i++) {
                if (nums[i] == nums[i+1]) {
                    // count++;
                    val = nums[i];
                }
                ans = val;
        }
        return ans;
    }
};
