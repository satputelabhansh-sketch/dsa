class Solution {
public:
    int majorityElement(vector<int>& nums) {
        int occur = 0, n = nums.size(), val;
        int moreval = n / 2;

        for (int i = 0; i < nums.size(); i++) {
            for (int j = n-1; j >= 0; j--) {
                if (nums[i] == nums[j]) {
                    val = nums[i];
                    occur++;
                }
            }
            if (occur > moreval) {
                return val;
                break; 
            } else {
                occur = 0;
            }
        }return val;
    }
};
